APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Production Gmail SMTP (Water email reminder) ----------------------------
# Select 'smtp' on the server: MAIL_MAILER=smtp + host/port/username + a Gmail
# App Password. MAIL_SCHEME=smtp = STARTTLS (Gmail port 587); smtps = implicit
# TLS (port 465); null = no TLS. MAIL_ENCRYPTION=tls is accepted too.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=stevenchristian2005@gmail.com
# MAIL_PASSWORD=            # Gmail App Password - isi langsung di .env server, JANGAN pernah di-commit
# MAIL_FROM_ADDRESS=stevenchristian2005@gmail.com
# MAIL_FROM_NAME="Menteng Kos Private"

# Water (PAM) admin notification defaults (overridable from Admin > Meter Air > Pengaturan)
WATER_ADMIN_WHATSAPP=081291903483
WATER_ADMIN_EMAIL=stevenchristian2005@gmail.com
WATER_SCHEDULER_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Cloud Vision OCR (opsi future, default OFF). OCR utama = Tesseract gratis.
VISION_OCR_ENABLED=false
# Kosongkan untuk fallback ke Tesseract. Enable "Cloud Vision API" lalu buat API key di https://console.cloud.google.com
GOOGLE_VISION_API_KEY=

VITE_APP_NAME="${APP_NAME}"
